<Window x:Class="BatteryAlert.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Battery Alert" Width="1280" Height="860" MinWidth="1060" MinHeight="720" Background="#10151B" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#0C1117" BorderBrush="#252E36" BorderThickness="0,0,1,0" Padding="20,30,20,22">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><Border Width="36" Height="36" CornerRadius="10" Background="#223D37" Margin="0,0,10,0"><Viewbox Margin="9"><Path Fill="{StaticResource Accent}" Data="M0,3 L16,3 16,7 19,7 19,13 16,13 16,17 0,17 Z M3,6 L3,14 13,14 13,6 Z"/></Viewbox></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Battery Alert" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="DEVICE MONITOR" Foreground="#76858F" FontSize="8.5" Margin="0,3,0,0"/></StackPanel></StackPanel>
     <TextBlock Text="SPAȚIUL TĂU" FontSize="9" Foreground="#63737E" Margin="14,39,0,12"/>
     <RadioButton x:Name="DevicesNav" GroupName="Navigation" Style="{StaticResource NavButton}" IsChecked="True" Checked="DevicesPageClick"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0" FontSize="16"/><TextBlock Text="Dispozitive"/></StackPanel></RadioButton>
     <RadioButton x:Name="SettingsNav" GroupName="Navigation" Style="{StaticResource NavButton}" Checked="SettingsPageClick"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0" FontSize="16"/><TextBlock Text="Alerte și telefon"/></StackPanel></RadioButton>
     <RadioButton x:Name="CompatibilityNav" GroupName="Navigation" Style="{StaticResource NavButton}" Checked="CompatibilityPageClick"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0" FontSize="16"/><TextBlock Text="Compatibilitate"/></StackPanel></RadioButton>
     <Button Style="{StaticResource QuietButton}" Click="DiagnosticClick" Margin="14,13,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons" Margin="0,0,12,0" FontSize="15"/><TextBlock Text="Diagnostic" FontSize="12"/></StackPanel></Button>
    </StackPanel>
    <Border Grid.Row="2" Background="#141D25" CornerRadius="10" Padding="14"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,7,0"/><TextBlock Text="Rulează în fundal" FontSize="11"/></StackPanel><TextBlock Text="Fereastra se poate închide.&#x0a;Monitorizarea continuă lângă ceas." Foreground="{StaticResource Muted}" FontSize="10" LineHeight="16" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel></Border>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="30,25,30,20">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="PREZENTARE GENERALĂ" Foreground="#83939E" FontSize="9" Margin="0,0,0,6"/><TextBlock x:Name="PageTitle" Text="Dispozitivele tale" FontSize="28" FontWeight="SemiBold"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#1C302C" CornerRadius="15" Padding="12,7" Margin="0,0,13,0"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,7,0"/><TextBlock Text="{Binding MonitorLabel}" Foreground="{StaticResource Accent}" FontSize="11"/></StackPanel></Border><Button Content="Verifică acum" Click="RefreshClick" Margin="0,0,8,0"/><Button Content="{Binding PauseLabel}" Click="PauseClick"/></StackPanel>
   </Grid>
   <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
     <StackPanel x:Name="DevicesPage">
      <Border CornerRadius="14" BorderBrush="#31433F" BorderThickness="1" Margin="0,0,0,24" ClipToBounds="True"><Border.Background><ImageBrush ImageSource="Assets/ambient-glass.png" Stretch="UniformToFill" AlignmentX="Right"/></Border.Background><Grid Height="143"><Border Background="#3410151B" CornerRadius="14"/><Grid Margin="24,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Totul sub control." FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Bateria potrivită. Alerta la momentul potrivit." Foreground="#ADBFBE" Margin="0,8,0,0"/><TextBlock Text="Verificare la 60 de secunde · praguri personalizabile" Foreground="#87A19F" FontSize="11" Margin="0,13,0,0"/></StackPanel><Border Grid.Column="1" VerticalAlignment="Center" Background="#99121F21" CornerRadius="10" Padding="20,13"><StackPanel><TextBlock Text="PRAG IMPLICIT" FontSize="9" Foreground="#9CB6B1"/><TextBlock Text="10%" FontSize="34" FontWeight="Light" Foreground="{StaticResource Accent}" Margin="0,2,0,0"/></StackPanel></Border></Grid></Grid></Border>
      <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="DISPOZITIVE" FontSize="9" Foreground="{StaticResource Muted}"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{Binding DeviceCount}" FontSize="23"/><TextBlock Text="în acest spațiu" Foreground="#7F919D" Margin="9,10,0,0" FontSize="11"/></StackPanel></StackPanel>
       <StackPanel Grid.Column="1"><TextBlock Text="CITIRI DISPONIBILE" FontSize="9" Foreground="{StaticResource Muted}"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{Binding LiveCount}" FontSize="23"/><TextBlock Text="dispozitive" Foreground="#7F919D" Margin="9,10,0,0" FontSize="11"/></StackPanel></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="SUB PRAG" FontSize="9" Foreground="{StaticResource Muted}"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{Binding LowCount}" FontSize="23" Foreground="#F4AF78"/><TextBlock Text="necesită încărcare" Foreground="#7F919D" Margin="9,10,0,0" FontSize="11"/></StackPanel></StackPanel>
      </Grid>
      <Grid Margin="0,0,0,14"><TextBlock Text="Dispozitive monitorizate" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Setările se aplică după salvare" HorizontalAlignment="Right" Foreground="#7F919D" FontSize="10" VerticalAlignment="Center"/></Grid>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
       <RadioButton Content="Toate" GroupName="DeviceFilter" Tag="All" IsChecked="True" Checked="FilterClick" Style="{StaticResource NavButton}" Padding="12,8"/>
       <RadioButton Content="Căști" GroupName="DeviceFilter" Tag="Headset" Checked="FilterClick" Style="{StaticResource NavButton}" Padding="12,8"/>
       <RadioButton Content="Mouse-uri" GroupName="DeviceFilter" Tag="Mouse" Checked="FilterClick" Style="{StaticResource NavButton}" Padding="12,8"/>
       <RadioButton Content="Tastaturi" GroupName="DeviceFilter" Tag="Keyboard" Checked="FilterClick" Style="{StaticResource NavButton}" Padding="12,8"/>
      </StackPanel>
      <ItemsControl ItemsSource="{Binding VisibleDevices}" HorizontalContentAlignment="Stretch">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate><DataTemplate>
        <Border Background="{StaticResource Surface}" BorderBrush="{Binding CardBorderBrush}" BorderThickness="1" CornerRadius="13" Padding="18" Margin="0,0,12,14" VerticalAlignment="Top">
         <StackPanel>
          <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Brand}" Foreground="#88A8AC" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,10,0"/></StackPanel><CheckBox Grid.Column="1" IsChecked="{Binding Settings.Enabled, Mode=TwoWay}" ToolTip="Monitorizează acest dispozitiv" AutomationProperties.Name="Monitorizare dispozitiv" VerticalAlignment="Top" Margin="0,1,0,0"/></Grid>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#E3E8E7" CornerRadius="10" Height="130" Margin="0,0,20,0" ClipToBounds="True"><Image Source="{Binding ProductImage}" Stretch="Uniform" Margin="7" RenderTransformOrigin="0.5,0.5" ToolTip="{Binding ImageCaption}" AutomationProperties.Name="Fotografie dispozitiv"><Image.RenderTransform><ScaleTransform ScaleX="{Binding PhotoZoom}" ScaleY="{Binding PhotoZoom}"/></Image.RenderTransform></Image></Border>
           <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Category}" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding Connection}" Foreground="#7F919D" FontSize="9" Margin="0,3,0,0"/><StackPanel Orientation="Horizontal" Margin="0,0,0,5"><TextBlock Text="{Binding BatteryValue}" FontSize="44" FontWeight="Light" Foreground="{Binding BatteryBrush}"/><TextBlock Text="{Binding PercentSuffix}" FontSize="19" Foreground="{Binding BatteryBrush}" Margin="3,21,0,0"/></StackPanel><ProgressBar Value="{Binding BatteryLevel, Mode=OneWay}" Maximum="100" Foreground="{Binding BatteryBrush}" Margin="0,0,0,10"/><TextBlock Text="{Binding BatteryNote}" Foreground="{Binding BatteryBrush}" FontSize="11" TextWrapping="Wrap" ToolTip="{Binding Detail}"/></StackPanel>
          </Grid>
          <Grid Margin="0,12,0,11"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding LastReadLabel}" Foreground="#8798A2" FontSize="10" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Fotografie" Click="ChooseImageClick" Style="{StaticResource QuietButton}" Padding="0" ToolTip="Alege propria fotografie pentru acest dispozitiv"/></Grid>
          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,13,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox Content="PC" FontSize="11" IsChecked="{Binding Settings.Desktop, Mode=TwoWay}" ToolTip="Notificări Windows"/><CheckBox Grid.Column="1" Content="Telefon" FontSize="11" IsChecked="{Binding Settings.Phone, Mode=TwoWay}" ToolTip="Notificări ntfy; activează și opțiunea globală"/><CheckBox Grid.Column="2" Content="Sunet" FontSize="11" IsChecked="{Binding Settings.Sound, Mode=TwoWay}" ToolTip="Sunet pe PC; respectă opțiunea globală"/></Grid></Border>
          <Expander Header="Personalizează alerta" FontSize="11" Margin="0,8,0,0"><StackPanel Margin="0,7,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Prag de alertă" Foreground="{StaticResource Ink}"/><TextBlock Text="Între 1% și 95%" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/></StackPanel><TextBox Grid.Column="1" Text="{Binding Settings.Threshold, Mode=TwoWay, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Prag procentual" HorizontalContentAlignment="Center"/></Grid><Button Content="Revino la imaginea de produs" Click="ResetImageClick" Style="{StaticResource QuietButton}" Margin="0,9,0,0"/></StackPanel></Expander>
         </StackPanel>
        </Border>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Background="#171E25" CornerRadius="12" Padding="24" Visibility="{Binding IsFilterEmpty, Converter={StaticResource BoolVisibility}}" Margin="0,4,12,14"><StackPanel><TextBlock Text="Niciun dispozitiv wireless în această categorie" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Conectează receiverul sau dispozitivul Bluetooth și verifică pagina Compatibilitate pentru modelele neconfirmate." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Border>
      <TextBlock Text="O valoare veche nu declanșează alerte. Dispozitivele oprite rămân marcate ca indisponibile." Foreground="#7F919D" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,16"/>
     </StackPanel>
     <StackPanel x:Name="CompatibilityPage" Visibility="Collapsed">
      <TextBlock Text="Wireless confirmat înainte de monitorizare." FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <TextBlock Text="Un receiver wireless este tot un dispozitiv USB. Modelele cu fir și cele neconfirmate sunt excluse din lista principală. Suportul bateriei depinde de protocolul fiecărui model." Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,22"/>
      <ItemsControl ItemsSource="{Binding Compatibility}"><ItemsControl.ItemTemplate><DataTemplate>
       <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,12"><StackPanel>
        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding CompatibilityStatus}" Foreground="{StaticResource Accent}" Margin="0,7,0,9" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Evidence}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="{Binding Hardware}" Foreground="#82959F"/><TextBlock Text=" · " Foreground="#82959F"/><TextBlock Text="{Binding Connection}" Foreground="#82959F"/></StackPanel>
        <TextBlock Text="{Binding Detail}" Foreground="#82959F" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"/>
       </StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="Validarea fizică pe fiecare model este consemnată în matricea de compatibilitate inclusă în pachet." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,12"/>
     </StackPanel>
     <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
      <TextBlock Text="Alege cum vrei să fii anunțat." Foreground="{StaticResource Muted}" FontSize="15" Margin="0,0,0,24"/>
      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="13" Padding="24" Margin="0,0,0,18"><StackPanel><TextBlock Text="Pe calculator" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Notificări discrete. Sunetul este redat separat, o singură dată." Foreground="{StaticResource Muted}" Margin="0,7,0,22" TextWrapping="Wrap"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><CheckBox Content="Sunet pentru alerte" IsChecked="{Binding DraftSettings.Sound, Mode=TwoWay}" Margin="0,0,0,20"/><CheckBox Content="Pornește la autentificarea în Windows" IsChecked="{Binding DraftSettings.StartWithWindows, Mode=TwoWay}"/></StackPanel><Button Grid.Column="1" Content="Testează pe PC" Click="TestDesktopClick" VerticalAlignment="Center"/></Grid></StackPanel></Border>
      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="13" Padding="24" Margin="0,0,0,18"><StackPanel><Grid><TextBlock Text="Pe telefon" FontSize="18" FontWeight="SemiBold"/><CheckBox Content="Activat" HorizontalAlignment="Right" IsChecked="{Binding DraftSettings.PhoneEnabled, Mode=TwoWay}"/></Grid><TextBlock Text="Primește alertele prin ntfy, chiar și când telefonul este blocat." Foreground="{StaticResource Muted}" Margin="0,7,0,22" TextWrapping="Wrap"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,15,0"><TextBlock Text="Server HTTPS" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8"/><TextBox Text="{Binding DraftSettings.NtfyServer, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Canalul tău ntfy" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8"/><TextBox Text="{Binding DraftSettings.NtfyTopic, Mode=TwoWay}"/></StackPanel></Grid>
       <Border Background="#111920" CornerRadius="9" Padding="16" Margin="0,18,0,18"><StackPanel><TextBlock Text="Conectează telefonul în trei pași" FontWeight="SemiBold"/><TextBlock Text="1. Instalează aplicația ntfy pe telefon.&#x0a;2. Adaugă o abonare folosind linkul canalului.&#x0a;3. Activează alertele, salvează și trimite un test." Foreground="{StaticResource Muted}" LineHeight="23" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Text="Păstrează canalul doar pentru tine." Foreground="#83A49E" FontSize="11" Margin="0,9,0,0"/></StackPanel></Border><StackPanel Orientation="Horizontal"><Button Content="Copiază linkul canalului" Click="CopyTopicClick" Margin="0,0,10,0"/><Button Content="Testează pe telefon" Click="TestPhoneClick"/></StackPanel></StackPanel></Border>
      <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="13" Padding="22"><StackPanel><TextBlock Text="Alerte fără repetări" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Primești o alertă la atingerea pragului. Alerta se reactivează după recuperarea a 5 puncte procentuale. Încărcarea suspendă alertele când dispozitivul o raportează." Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0"/></StackPanel></Border>
     </StackPanel>
    </Grid>
   </ScrollViewer>
   <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,17,0,0" Margin="0,12,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,15,0"><TextBlock Text="{Binding Status}" Foreground="#A7BBB8" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding LastEvent}" Foreground="#758995" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="Salvează setările" Style="{StaticResource PrimaryButton}" Click="SaveClick" VerticalAlignment="Center"/></Grid></Border>
  </Grid>
 </Grid>
</Window>
